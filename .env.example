# ==============================================================================
# Educational Management System - Root Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=replace_with_a_long_random_entropy_string_for_production
JWT_EXPIRES_IN=24h

# Database Configuration (Leave blank for zero-config embedded SQLite)
# To use PostgreSQL in production, supply DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/educational_management

# Frontend Configuration (Used when building frontend)
# If hosted on the same domain or behind reverse proxy, keep default:
# REACT_APP_API_URL=/api
# If backend is hosted on a separate subdomain or domain:
# REACT_APP_API_URL=https://api.yourdomain.com/api

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
